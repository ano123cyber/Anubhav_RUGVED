
# ============================================================
# TASK 7: ARTIFICIAL NEURAL NETWORK FROM SCRATCH ON MNIST
# Libraries: NumPy, Pandas, Matplotlib
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

np.random.seed(42)


# ============================================================
# PART 1: LOAD mnist_train.csv
# ============================================================

print("PART 1: LOADING TRAINING DATA")

train_data = pd.read_csv("mnist_train.csv")
test_data = pd.read_csv("mnist_test.csv")

print("Training dataset shape:", train_data.shape)
print(train_data.head())

# Separate labels and pixel values
y_train = train_data["label"].to_numpy(dtype=np.int64)

X_train = train_data.drop("label", axis=1).to_numpy(
    dtype=np.float32
)

# Normalize pixel values from 0-255 to 0-1
X_train = X_train / 255.0

# Transpose: each column represents one image
X_train = X_train.T

print("X_train shape:", X_train.shape)
print("y_train shape:", y_train.shape)


# ============================================================
# PART 2: VISUALIZE SAMPLE TRAINING IMAGES
# ============================================================

plt.figure(figsize=(10, 4))

for i in range(10):
    plt.subplot(2, 5, i + 1)
    plt.imshow(X_train[:, i].reshape(28, 28), cmap="gray",interpolation='nearest')
    plt.title(f"Label: {y_train[i]}")
    plt.axis("off")

plt.suptitle("Sample MNIST Training Images")
plt.tight_layout()
plt.show()


# ============================================================
# PART 3: INITIALIZE WEIGHTS AND BIASES
# Architecture: 784 INPUTS -> 128 HIDDEN NEURONS -> 10 OUTPUTS
# ============================================================

W1 = np.random.randn(128, 784) * np.sqrt(2.0 / 784)
b1 = np.zeros((128, 1))

W2 = np.random.randn(10, 128) * np.sqrt(2.0 / 128)
b2 = np.zeros((10, 1))


# ============================================================
# PART 4: ACTIVATION FUNCTIONS
# ============================================================

def relu(Z):
    return np.maximum(0, Z)


def softmax(Z):
    # Subtract maximum for numerical stability
    Z = Z - np.max(Z, axis=0, keepdims=True)
    exp_Z = np.exp(Z)
    return exp_Z / np.sum(exp_Z, axis=0, keepdims=True)


# ============================================================
# PART 5: FORWARD PROPAGATION
# ============================================================

def forward_propagation(X):
    Z1 = W1 @ X + b1
    A1 = relu(Z1)

    Z2 = W2 @ A1 + b2
    A2 = softmax(Z2)

    return Z1, A1, A2


# ============================================================
# PART 6: LOSS FUNCTION
# Categorical cross-entropy
# ============================================================

def calculate_loss(A2, Y):
    epsilon = 1e-9
    m = Y.shape[1]

    loss = -np.sum(Y * np.log(A2 + epsilon)) / m

    return loss


# ============================================================
# PART 7: BACKPROPAGATION
# Calculate gradients using the chain rule
# ============================================================

def backward_propagation(X, Y, Z1, A1, A2):
    m = X.shape[1]

    # Output layer gradients
    dZ2 = A2 - Y
    dW2 = (dZ2 @ A1.T) / m
    db2_grad = np.sum(dZ2, axis=1, keepdims=True) / m

    # Hidden layer gradients
    dZ1 = (W2.T @ dZ2) * (Z1 > 0)
    dW1 = (dZ1 @ X.T) / m
    db1_grad = np.sum(dZ1, axis=1, keepdims=True) / m

    return dW1, db1_grad, dW2, db2_grad


# ============================================================
# PART 8: LOAD mnist_test.csv
# ============================================================

print("\nPART 2: LOADING TESTING DATA")

test_data = pd.read_csv("mnist_test.csv")

print("Testing dataset shape:", test_data.shape)

y_test = test_data["label"].to_numpy(dtype=np.int64)

X_test = test_data.drop("label", axis=1).to_numpy(
    dtype=np.float32
)

X_test = (X_test / 255.0).T

print("X_test shape:", X_test.shape)
print("y_test shape:", y_test.shape)


# ============================================================
# PART 9: TRAIN THE ANN USING GRADIENT DESCENT
# ============================================================

learning_rate = 0.1
epochs = 20
batch_size = 64

m = X_train.shape[1]

loss_history = []
accuracy_history = []

print("\nSTARTING ANN TRAINING")

for epoch in range(epochs):

    # Shuffle training examples
    permutation = np.random.permutation(m)

    X_shuffled = X_train[:, permutation]
    y_shuffled = y_train[permutation]

    total_loss = 0.0

    for start in range(0, m, batch_size):

        end = min(start + batch_size, m)

        X_batch = X_shuffled[:, start:end]
        y_batch = y_shuffled[start:end]

        # Convert digit labels to one-hot encoded vectors
        Y = np.eye(10, dtype=np.float32)[y_batch].T

        # Forward propagation
        Z1, A1, A2 = forward_propagation(X_batch)

        # Calculate loss
        batch_loss = calculate_loss(A2, Y)
        total_loss += batch_loss * X_batch.shape[1]

        # Backpropagation
        dW1, db1_grad, dW2, db2_grad = backward_propagation(
            X_batch, Y, Z1, A1, A2
        )

        # Gradient descent: update weights and biases
        W1 -= learning_rate * dW1
        b1 -= learning_rate * db1_grad

        W2 -= learning_rate * dW2
        b2 -= learning_rate * db2_grad

    # Average training loss for this epoch
    average_loss = total_loss / m
    loss_history.append(average_loss)

    # Evaluate on the separate test dataset
    _, _, test_probs = forward_propagation(X_test)

    test_predictions = np.argmax(test_probs, axis=0)
    test_accuracy = np.mean(test_predictions == y_test) * 100

    accuracy_history.append(test_accuracy)

    print(
        f"Epoch {epoch + 1}/{epochs} | "
        f"Loss: {average_loss:.4f} | "
        f"Test Accuracy: {test_accuracy:.2f}%"
    )


# ============================================================
# PART 10: FINAL TEST EVALUATION
# ============================================================

_, _, test_probs = forward_propagation(X_test)

predicted_labels = np.argmax(test_probs, axis=0)

correct_predictions = np.sum(predicted_labels == y_test)
total_predictions = len(y_test)

accuracy = (correct_predictions / total_predictions) * 100

print("\nFINAL RESULTS")
print("Total test images:", total_predictions)
print("Correct predictions:", correct_predictions)
print("Incorrect predictions:", total_predictions - correct_predictions)
print(f"Final test accuracy: {accuracy:.2f}%")


# ============================================================
# PART 11: GRAPH 1 - TRAINING LOSS VS EPOCHS
# ============================================================

plt.figure(figsize=(8, 5))

plt.plot(
    range(1, epochs + 1),
    loss_history,
    marker="o",
    label="Training Loss"
)

plt.xlabel("Epoch")
plt.ylabel("Cross-Entropy Loss")
plt.title("Training Loss vs Epochs")
plt.xticks(range(1, epochs + 1))
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()


# ============================================================
# PART 12: GRAPH 2 - TEST ACCURACY VS EPOCHS
# ============================================================

plt.figure(figsize=(8, 5))

plt.plot(
    range(1, epochs + 1),
    accuracy_history,
    marker="o",
    label="Test Accuracy"
)

plt.xlabel("Epoch")
plt.ylabel("Accuracy (%)")
plt.title("Test Accuracy vs Epochs")
plt.xticks(range(1, epochs + 1))
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()


# ============================================================
# PART 13: DISPLAY PREDICTED VS ACTUAL DIGITS
# ============================================================

plt.figure(figsize=(12, 5))

for i in range(15):
    plt.subplot(3, 5, i + 1)

    image = X_test[:, i].reshape(28, 28)
    plt.imshow(image, cmap="gray", interpolation='nearest')

    actual = y_test[i]
    predicted = predicted_labels[i]

    plt.title(
        f"Actual: {actual}\nPredicted: {predicted}",
        color="green" if actual == predicted else "red"
    )

    plt.axis("off")

plt.suptitle("ANN Predictions on MNIST Test Images")
plt.tight_layout()
plt.show()


# ============================================================
# PART 14: DISPLAY FINAL SUMMARY
# ============================================================

print("\nANN IMPLEMENTATION COMPLETED")
print("Input neurons: 784")
print("Hidden neurons: 128")
print("Output neurons: 10")
print("Activation functions: ReLU and Softmax")
print("Loss function: Categorical Cross-Entropy")
print("Optimization: Mini-batch Gradient Descent")
print(f"Epochs: {epochs}")
print(f"Learning rate: {learning_rate}")
print(f"Final test accuracy: {accuracy:.2f}%")
